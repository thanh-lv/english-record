# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL dự án Supabase (tìm thấy trong Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (khóa công khai cho client-side)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# S3 / Cloudflare R2 Storage Configuration (File & Audio Uploads)
# ==============================================================================
# Endpoint kết nối S3 tương thích (ví dụ Cloudflare R2)
VITE_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Vùng lưu trữ (đặt "auto" đối với Cloudflare R2 hoặc us-east-1 với AWS S3)
VITE_S3_REGION=auto

# Khóa truy cập S3 / R2 (Access Key ID)
VITE_S3_ACCESS_KEY_ID=your-s3-access-key-id

# Khóa bí mật S3 / R2 (Secret Access Key)
VITE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Tên bucket lưu trữ audio, hình ảnh và tài liệu
VITE_S3_BUCKET_NAME=english-record

# Domain công khai để truy cập file sau khi upload (R2 Public Bucket URL hoặc CDN)
VITE_R2_PUBLIC_URL=https://pub-your-bucket-hash.r2.dev
# VITE_S3_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# ==============================================================================
# AI & Cloudflare Workers Configuration
# ==============================================================================
# API Key dùng để gọi Cloudflare Worker tạo truyện AI, tạo hình ảnh và sinh phiên âm IPA
VITE_AI_API_KEY=your-ai-api-key-here

# (Tùy chọn) Cloudflare Account ID & API Token
VITE_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
VITE_CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# (Tùy chọn) Google Gemini API Key
VITE_GEMINI_API_KEY=your-gemini-api-key-here
